<Window x:Class="SemiconductorEquipmentSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiconductorEquipmentSimulator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="SEMICONDUCTOR EQUIPMENT" FontSize="30"/>
        <TextBlock x:Name="StatusText" Text="STATUS : STOPPED" FontSize="24" Margin="0,60,0,0"/>
        <Button Content="START"
        Width="120"
        Height="50"
        Margin="0,120,0,0"
        Click="StartButton_Click"/>
        <Button Content="STOP"
        Width="120"
        Height="50"
        Margin="140,120,0,0"
        Click="StopButton_Click"/>
    </Grid>
</Window>
