<Window x:Class="SemiconductorEquipmentSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Semiconductor Equipment Simulator"
        Height="450"
        Width="700">

    <!-- 화면 전체를 담당하는 Grid -->
    <Grid Margin="30">

        <!-- 세로 방향으로 6개의 행을 만듦 -->
        <Grid.RowDefinitions>

            <!-- Row 0 : 제목 -->
            <RowDefinition Height="Auto"/>

            <!-- Row 1 : 상태 -->
            <RowDefinition Height="Auto"/>

            <!-- Row 2 : 온도 -->
            <RowDefinition Height="Auto"/>

            <!-- Row 3 : 압력 -->
            <RowDefinition Height="Auto"/>

            <!-- Row 4 : 남는 공간 -->
            <RowDefinition Height="*"/>

            <!-- Row 5 : 버튼 -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- Row 0 : 프로그램 제목 -->
        <!-- ========================= -->

        <TextBlock
            Grid.Row="0"
            Text="SEMICONDUCTOR EQUIPMENT"
            FontSize="30"
            FontWeight="Bold"
            Margin="0,0,0,30"/>


        <!-- ========================= -->
        <!-- Row 1 : 장비 상태 -->
        <!-- ========================= -->

        <TextBlock
            Grid.Row="1"
            x:Name="StatusText"
            Text="STATUS : STOPPED"
            FontSize="24"
            Margin="0,0,0,20"/>


        <!-- ========================= -->
        <!-- Row 2 : 온도 -->
        <!-- ========================= -->

        <TextBlock
            Grid.Row="2"
            x:Name="TemperatureText"
            Text="TEMPERATURE : 25 °C"
            FontSize="24"
            Margin="0,0,0,20"/>


        <!-- ========================= -->
        <!-- Row 3 : 압력 -->
        <!-- ========================= -->

        <TextBlock
            Grid.Row="3"
            x:Name="PressureText"
            Text="PRESSURE : 760 Torr"
            FontSize="24"/>


        <!-- ========================= -->
        <!-- Row 5 : 버튼 영역 -->
        <!-- ========================= -->

        <Grid Grid.Row="5">

            <!-- 버튼 영역을 좌우 2칸으로 나눔 -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- 왼쪽 칸 -->
            <Button
                Grid.Column="0"
                Content="START"
                Height="60"
                Margin="0,0,10,0"
                Click="StartButton_Click"/>


            <!-- 오른쪽 칸 -->
            <Button
                Grid.Column="1"
                Content="STOP"
                Height="60"
                Margin="10,0,0,0"
                Click="StopButton_Click"/>

            <Button
                Grid.Column="2"
                Content="OVERHEAT TEST"
                Height="60"
                Margin="10,0,0,0"
                Click="OverheatTestButton_Click"/>

            <Button
                Grid.Column="3"
                Content="RESET"
                Height="60"
                Margin="10,0,0,0"
                Click="ResetButton_Click"/>

        </Grid>

    </Grid>

</Window>