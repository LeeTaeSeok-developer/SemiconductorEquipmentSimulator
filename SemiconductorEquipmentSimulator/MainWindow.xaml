<Window x:Class="SemiconductorEquipmentSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Semiconductor Equipment Simulator"
        Height="450"
        Width="700">

    <!-- 화면 전체를 담당하는 Grid -->
    <Grid Margin="30">

        <!-- 세로 방향으로 6개의 행을 만듦 -->
        <Grid.RowDefinitions>

            <!-- Row 0 : 제목 -->
            <RowDefinition Height="Auto"/>

            <!-- 상태 -->
            <RowDefinition Height="Auto"/>

            <!-- 온도 -->
            <RowDefinition Height="Auto"/>

            <!-- 압력 -->
            <RowDefinition Height="Auto"/>

            <!-- 공정 단계 -->
            <RowDefinition Height="Auto"/>
            
            <!-- 생산 횟수-->
            <RowDefinition Height="Auto"/>

            <!-- 로그 영역 -->
            <RowDefinition Height="*"/>

            <!-- 버튼 -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- 프로그램 제목 -->


        <TextBlock
            Grid.Row="0"
            Text="반도체 장비 제어 시뮬레이터"
            FontSize="30"
            FontWeight="Bold"
            Margin="0,0,0,30"/>



        <!-- 장비 상태 -->


        <TextBlock
            Grid.Row="1"
            x:Name="StatusText"
            Text="상태 : 정지"
            FontSize="24"
            Margin="0,0,0,20"/>



        <!-- 온도 -->


        <TextBlock
            Grid.Row="2"
            x:Name="TemperatureText"
            Text="온도 : 25 °C"
            FontSize="24"
            Margin="0,0,0,20"/>


        <!-- 압력 -->


        <TextBlock
            Grid.Row="3"
            x:Name="PressureText"
            Text="압력 : 760 Torr"
            FontSize="24"/>
   
        <!--공정단계-->
        <TextBlock
            Grid.Row="4"
            x:Name="ProcessStepText"
            Text="공정 단계 : Idle"
            FontSize="20"
            Margin="0,20,0,0"/>
        
        
        <!--생산횟수-->
        <TextBlock
            Grid.Row="5"
            x:Name="CycleCountText"
            Text="생산 횟수 : 0"
            FontSize="20"
            Margin="0,10,0,0"/>

        <!--로그-->
        <StackPanel Grid.Row="6" Margin="0,20,0,20">

            <TextBlock
                Text="장비 로그"
                FontSize="18"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

            <ListBox
                x:Name="LogList"
                Height="120"/>

        </StackPanel>


        <!-- ========================= -->
        <!-- Row 5 : 버튼 영역 -->
        <!-- ========================= -->

        <Grid Grid.Row="7">

            <!-- 버튼 영역 -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- 왼쪽 칸 -->
            <Button
                Grid.Column="0"
                Content="시작"
                Height="60"
                Margin="0,0,10,0"
                Click="StartButton_Click"/>


            <!-- 오른쪽 칸 -->
            <Button
                Grid.Column="1"
                Content="정지"
                Height="60"
                Margin="10,0,0,0"
                Click="StopButton_Click"/>

            <Button
                Grid.Column="2"
                Content="과열 테스트"
                Height="60"
                Margin="10,0,0,0"
                Click="OverheatTestButton_Click"/>

            <Button
                Grid.Column="3"
                Content="초기화"
                Height="60"
                Margin="10,0,0,0"
                Click="ResetButton_Click"/>

            <Button
                Grid.Column="4"
                Content="압력 이상 테스트"
                Height="60"
                Margin="10,0,0,0"
                Click="PressureErrorTestButton_Click"/>

            <Button
                Grid.Column="5"
                Content="센서 이상 테스트"
                Height="60"
                Margin="10,0,0,0"
                Click="SensorErrorTestButton_Click"/>

            <Button
                  Grid.Column="6"
                  Content="공정 시작"
                  Height="60"
                  Margin="10,0,0,0"
                  Click="ProcessStartButton_Click"/>

        </Grid>

    </Grid>

</Window>